# XDG base dir spec
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"

# Default programs
export EDITOR="nano"

# History files
export LESSHISTFILE="$XDG_CACHE_HOME/less_history"

# Custom
export CONFIG_DIR="$HOME/.linux-config"
export KEYCHAIN_KEYS=(id_rsa homelab homelab-old homelab-vps github-auth github-sign)
